# ------------------------------------------------------------------
# Copy this file to `.env` and change the values for your machine:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore, so your real values never get
# committed. This example file IS committed, so anyone cloning the
# repo can see which settings the app expects.
# ------------------------------------------------------------------

# Which port the web server listens on. Visit http://localhost:3000
PORT=3000

# Where the database is. A `file:` URL is a local SQLite file (the
# folder is created for you). In production this is your Turso
# database's libsql:// URL instead; see the README's "Deploying".
DATABASE_URL=file:./data/forest.db

# Turso's access token. Not needed for a local file, so leave it out.
# DATABASE_AUTH_TOKEN=

# How much work bcrypt does per password ("cost factor").
# Each +1 doubles the time it takes to hash, which also doubles the
# time an attacker needs per guess. 12 is a sensible default today.
BCRYPT_ROUNDS=12

# The secret used to sign session cookies. It must be long, random
# and private: anyone who knows it could forge a valid cookie.
# Generate one with:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Use a different secret on every machine. Changing it logs everyone out.
SESSION_SECRET=replace-me-with-a-long-random-string

# How many days a new invite link stays valid.
INVITE_TTL_DAYS=7

# The site's public address, used by `npm run invite` to print full
# links. Leave it unset locally; it defaults to http://localhost:PORT.
# Set it in .env.production (see the README) for `npm run invite:prod`.
# APP_URL=https://forest.example.com

# Set to "production" on a real server. This turns on secure (HTTPS
# only) cookies and makes SESSION_SECRET required. Leave it unset
# on your laptop, because localhost uses plain HTTP.
# NODE_ENV=production

# Production only: how many proxies sit in front of the app (see
# server.js). 1 is right for most hosts; /admin/connection shows
# whether it is right for yours.
# TRUST_PROXY=1
